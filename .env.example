NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL Database URL (matches docker-compose.yml)
DATABASE_URL="postgresql://streamforge:streamforge_dev@localhost:5432/streamforge"

# Redis URL for BullMQ queue & pub/sub
REDIS_URL="redis://localhost:6379"

# Local storage directory root for uploads
LOCAL_STORAGE_ROOT="./storage"

# Worker concurrency settings
WORKER_CONCURRENCY=2